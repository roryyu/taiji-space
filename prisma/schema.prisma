// 太极空间 - 数据模型定义
// Prisma 7：使用 prisma-client 生成器 + @prisma/adapter-pg 驱动适配器

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // 生成代码内部使用 .ts 扩展名导入，便于 Node 原生类型剥离直接运行（如 seed 脚本）
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------- 枚举 ----------

/// 获客渠道
enum AcquisitionChannel {
  WALK_IN // 到店咨询
  REFERRAL // 老会员转介绍
  ONLINE // 线上引流
  ACTIVITY // 活动获客
  OTHER // 其他
}

/// 卡流水类型
enum TransactionType {
  RECHARGE // 充值
  DEDUCT // 扣减
  EXTEND // 有效期延长
}

/// 员工类型
enum StaffType {
  TEACHER // 教练
  MANAGER // 经理
  ADMINISTRATOR // 管理员
}

/// 性别
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// 排期状态
enum ScheduleStatus {
  PENDING // 未上课
  COMPLETED // 已上课
}

// ---------- 模型 ----------

/// 店铺（系统配置-店铺）
model Store {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  address       String
  businessHours String // 经营时段，如 "09:00-21:00"
  staffId       Int? // 店长（关联 Staff，type 为 MANAGER）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  manager Staff?         @relation(fields: [staffId], references: [id])
  cards   MembershipCard[]
  feedbacks MemberFeedback[]

  @@index([staffId])
}

/// 员工
model Staff {
  id            Int      @id @default(autoincrement())
  name          String
  qualification String? // 资质
  styleTags     String[] // 风格标签
  account       String   @unique // 登录账号
  password      String // bcrypt 哈希
  type          StaffType @default(TEACHER) // 员工类型
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards   MembershipCard[] @relation("CoachCards")
  created MembershipCard[] @relation("CreatorCards")
  stores  Store[] // 作为店长管理的店铺
  feedbacks MemberFeedback[]
}

/// 会员信息
model Member {
  id             Int                @id @default(autoincrement())
  name           String // 顾客姓名
  phone          String             @unique // 手机号
  channel        AcquisitionChannel @default(WALK_IN) // 获客渠道
  gender         Gender? // 性别
  birthday       DateTime? // 生日
  physicalDisease String? // 生理疾病
  mentalDisease   String? // 心理疾病
  isSportsInjuryRecovery Boolean @default(false) // 是否运动伤害康复
  isHypertension  Boolean @default(false) // 是否高血压
  isHyperlipidemia Boolean @default(false) // 是否高血脂
  isHyperglycemia Boolean @default(false) // 是否高血糖
  firstCardDate   DateTime? // 首次开卡时间
  preferenceTags String[] // 标签-课程偏好
  remark         String? // 标签-备注
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  cards     MembershipCard[]
  reviews   CourseReview[]
  schedules CourseSchedule[]
  feedbacks MemberFeedback[]
}

/// 会员卡
model MembershipCard {
  id            Int      @id @default(autoincrement())
  cardNo        String   @unique // 卡号（自动生成）
  memberId      Int
  storeId       Int      @default(1) // 所属门店
  courseId      Int      @default(1) // 关联课程
  coachId       Int      @default(1) // 关联教练
  staffId       Int? // 创建员工（MANAGER/ADMINISTRATOR）
  totalAmount   Int      @default(0) // 总金额（元）
  totalSessions Int      @default(0) // 总次数
  giftSessions  Int      @default(0) // 赠送次数
  validFrom     DateTime // 有效期起
  validTo       DateTime // 有效期止
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member       Member            @relation(fields: [memberId], references: [id])
  store        Store             @relation(fields: [storeId], references: [id])
  course       Course            @relation(fields: [courseId], references: [id])
  coach        Staff             @relation("CoachCards", fields: [coachId], references: [id])
  creator      Staff?            @relation("CreatorCards", fields: [staffId], references: [id])
  transactions CardTransaction[]
  schedules    CourseSchedule[]

  @@index([memberId])
  @@index([storeId])
  @@index([courseId])
  @@index([coachId])
  @@index([staffId])
}

/// 会员卡流水
model CardTransaction {
  id        Int             @id @default(autoincrement())
  cardId    Int
  type      TransactionType
  amount    Decimal         @default(0) @db.Decimal(12, 2)
  remark    String?
  createdAt DateTime        @default(now())

  card MembershipCard @relation(fields: [cardId], references: [id])

  @@index([cardId])
}

/// 课程
model Course {
  id          Int      @id @default(autoincrement())
  name        String // 课程名称
  description String? // 课程描述
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules CourseSchedule[]
  reviews   CourseReview[]
  cards     MembershipCard[]
  feedbacks MemberFeedback[]
}

/// 课程排期
model CourseSchedule {
  id        Int            @id @default(autoincrement())
  cardId    Int // 关联会员卡
  memberId  Int // 关联会员
  courseId  Int // 关联课程
  startTime DateTime // 课程时段-开始
  endTime   DateTime // 课程时段-结束
  status    ScheduleStatus @default(PENDING) // 排期状态
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  card   MembershipCard @relation(fields: [cardId], references: [id])
  member Member         @relation(fields: [memberId], references: [id])
  course Course         @relation(fields: [courseId], references: [id])

  @@index([cardId])
  @@index([memberId])
  @@index([courseId])
  @@index([startTime])
}



/// 课程评价
model CourseReview {
  id         Int      @id @default(autoincrement())
  memberId   Int // 会员
  courseId   Int // 课程
  rating     Int // 评分 1-5
  suggestion String? // 建议
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  // 同一会员对同一课程只允许一条评价
  @@unique([memberId, courseId])
  @@index([courseId])
  @@index([memberId])
}

/// 系统参数（key-value）
model SystemParam {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// 会员沟通反馈（运营红灯客户的跟进记录：预约上课/为什么不来上课/近况等）
model MemberFeedback {
  id        Int      @id @default(autoincrement())
  memberId  Int
  storeId   Int      @default(1) // 所属门店
  courseId  Int      @default(1) // 关联课程
  coachId   Int      @default(1) // 关联教练
  content   String? // 沟通内容记录
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  coach  Staff  @relation(fields: [coachId], references: [id])

  @@index([memberId])
  @@index([storeId])
  @@index([courseId])
  @@index([coachId])
}
